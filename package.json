{
  "name": "prompt-to-page",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "实时造物工坊 · 一句话，页面当场长出来 —— MiniMax M3.1 Flash 前端能力现场演示",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flower-forever/prompt-to-page.git"
  },
  "scripts": {
    "predev": "npm run vendor",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "vendor": "node scripts/vendor.mjs",
    "prebuild": "npm run vendor",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "record": "tsx scripts/record.ts",
    "capture": "node scripts/capture.mjs",
    "shot": "node scripts/shot.mjs",
    "e2e": "node scripts/e2e.mjs",
    "ui-check": "node scripts/ui-check.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@tailwindcss/browser": "^4.3.3",
    "dotenv": "^17.2.3",
    "framer-motion": "14.5.0",
    "highlight.js": "^11.11.1",
    "hono": "4.13.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sucrase": "^3.35.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "gifenc": "^1.0.3",
    "playwright": "^1.57.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "8.3.5"
  }
}
